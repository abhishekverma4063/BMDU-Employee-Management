# ─── Production (Render + Railway) ───────────────────────────────
# Paste the full MySQL connection string from Railway here
DATABASE_URL=mysql://<user>:<password>@<host>:<port>/railway

NODE_ENV=production
PORT=5000

# Your Vercel frontend URL (set after deploying frontend)
CLIENT_URL=https://your-app.vercel.app

# ─── Local Development (alternative to DATABASE_URL) ─────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=bmdu_employees
# DB_USER=root
# DB_PASSWORD=your_mysql_password
